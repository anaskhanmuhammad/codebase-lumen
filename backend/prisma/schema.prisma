generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId      String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  username    String   @unique
  imageUrl    String?
  role        String   @default("user")
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  apiKeys      UserApiKey[]
  projects     Project[]
  chatSessions ChatSession[]
}

model UserApiKey {
  keyId            String    @id @default(cuid())
  userId           String
  name             String?
  provider         String
  encryptedKey     String
  maskedKey        String?
  keyMetadata      Json?
  isActive         Boolean   @default(true)
  isValidated      Boolean   @default(false)
  validationStatus String?
  validationError  String?
  lastValidationAt DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [userId])
}

 


model Language {
  languageId   String @id @default(cuid())
  languageName String @unique
  projectLanguages   ProjectLanguage[]
  comparisons        Comparison[]
}

 

model Provider {
  providerId   String   @id @default(cuid())
  providerName String   @unique
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  llms Llm[]
}

model Llm {
  llmId             String  @id @default(cuid())
  llmName           String  @unique
  providerId        String
  modelIdentifier   String
  description       String?
  isActive          Boolean @default(true)

  provider         Provider         @relation(fields: [providerId], references: [providerId])
  comparisons      Comparison[]
  codeSamples      CodeSample[]
}

 

model Project {
  projectId    String   @id @default(cuid())
  userId       String
  projectName  String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  topLanguage  String?

  user             User              @relation(fields: [userId], references: [userId])
  projectLanguages ProjectLanguage[]
  comparisons      Comparison[]
}

model ProjectLanguage {
  projectLanguageId String @id @default(cuid())
  projectId         String
  languageId        String
  percentage        Float

  project  Project  @relation(fields: [projectId], references: [projectId])
  language Language @relation(fields: [languageId], references: [languageId])
}

 

model Comparison {
  comparisonId     String    @id @default(cuid())
  projectId        String
  name             String?
  type             String?
  languageId       String?
  promptText       String?
  status           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?
  analyzerVersions Json?
  llmId            String?

  project      Project?      @relation(fields: [projectId], references: [projectId])
  language     Language?     @relation(fields: [languageId], references: [languageId])
  llm          Llm?          @relation(fields: [llmId], references: [llmId])
  codeSamples  CodeSample[]
  chatSessions ChatSession[]
}

model CodeSample {
  codeSampleId   String    @id @default(cuid())
  comparisonId   String
  codeType       String
  llmId          String?
  codeContent    String
  source         String?
  repositoryUrl  String?
  isOriginal     Boolean   @default(false)
  promptUsed     String?
  generatedAt    DateTime?
  modificationNote String?
  createdAt      DateTime  @default(now())

  comparison       Comparison        @relation(fields: [comparisonId], references: [comparisonId])
  llm              Llm?              @relation(fields: [llmId], references: [llmId])
  vulnerabilities  Vulnerability[]
  analyzerResults  AnalyzerResult[]
}

 

model AnalyzerResult {
  resultId       String   @id @default(cuid())
  codeSampleId   String
  analyzerType   String
  rawOutput      Json     // Exact payload from analyzer
  executedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  codeSample CodeSample @relation(fields: [codeSampleId], references: [codeSampleId], onDelete: Cascade)

  @@unique([codeSampleId, analyzerType])
}

 

model Vulnerability {
  vulnerabilityId              String   @id @default(cuid())
  codeSampleId                 String
  
  ruleId                       String?
  name                         String?
  description                  String?

  message                      Json?
  locations                    Json?
  properties                   Json?
  fixes                        Json?

  level                        String?
  helpUri                      String?
  filePath                     String?
  lineNumber                   Int?

  severity                     String?
  severityScore                Float?
  confidence                   String?
  confidenceScore              Float?
  severityByEachAnalyzer       Json?
  confidenceScoreByEachAnalyzer Json?
  detectedBy                   Json?
  allStandardsViolated         Json?

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  codeSample       CodeSample        @relation(fields: [codeSampleId], references: [codeSampleId])
  chatConversations ChatConversation[]
}

 

 

model ChatSession {
  chatSessionId String   @id @default(cuid())
  userId        String
  comparisonId  String?
  vulnerabilityId String?
  startedAt     DateTime @default(now())
  lastUpdated   DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [userId])
  comparison    Comparison?        @relation(fields: [comparisonId], references: [comparisonId])
  conversations ChatConversation[]
}

model ChatConversation {
  messageId       String   @id @default(cuid())
  chatSessionId   String
  messageText     String
  timestamp       DateTime @default(now())
  vulnerabilityId String?
  type            String?
  generatedOutput String?
  isHelpful       Boolean?

  chatSession   ChatSession    @relation(fields: [chatSessionId], references: [chatSessionId])
  vulnerability Vulnerability? @relation(fields: [vulnerabilityId], references: [vulnerabilityId])
}

